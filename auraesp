#include <WiFi.h>
#include "BluetoothSerial.h"
#include <BLEDevice.h>
#include <BLEScan.h>
#include <BLEAdvertisedDevice.h>

// Ensure Bluetooth is enabled for the board
#if !defined(CONFIG_BT_ENABLED) || !defined(CONFIG_BLUEDROID_ENABLED)
#error Bluetooth is not enabled! Please use an ESP32 board with Bluetooth support.
#endif

BluetoothSerial SerialBT;
bool btActive = false;

void setup() {
  Serial.begin(115200);
  delay(1000);

  // Set Wi-Fi to Access Point mode and set max power
  WiFi.mode(WIFI_AP);
  WiFi.setTxPower(WIFI_POWER_19_5dBm);

  Serial.println("\nESP32 Multi-Tool Ready (MAX Wi-Fi Power Enabled).");
  printHelp();
}

void loop() {
  if (Serial.available()) {
    String input = Serial.readStringUntil('\n');
    input.trim();

    if (input.startsWith("/wifi ")) {
      String ssid = input.substring(6);
      ssid.trim();
      createWiFi(ssid);
    } 
    else if (input.startsWith("/bt ")) {
      String btName = input.substring(4);
      btName.trim();
      createBluetooth(btName);
    } 
    else if (input == "/signal") {
      scanBluetoothSignals();
    } 
    else if (input == "/stop") {
      stopAll();
    }
    else if (input == "/help") {
      printHelp();
    } 
    else if (input.length() > 0) {
      Serial.println("Unknown command. Type /help to see available commands.");
    }
  }
}

void createWiFi(String ssid) {
  if (ssid.length() == 0) {
    Serial.println("Error: Please provide a Wi-Fi name. Example: /wifi MyNetwork");
    return;
  }
  
  WiFi.mode(WIFI_AP);
  WiFi.setTxPower(WIFI_POWER_19_5dBm);
  WiFi.softAP(ssid.c_str()); 
  
  Serial.print("Broadcasting Wi-Fi Network at MAX POWER: ");
  Serial.println(ssid);
  Serial.print("AP IP Address: ");
  Serial.println(WiFi.softAPIP());
}

void createBluetooth(String name) {
  if (name.length() == 0) {
    Serial.println("Error: Please provide a Bluetooth name. Example: /bt AirPods");
    return;
  }
  
  if (btActive) {
    SerialBT.end();
  }
  SerialBT.begin(name.c_str());
  btActive = true;
  
  Serial.print("Bluetooth is active and discoverable as: ");
  Serial.println(name);
}

void scanBluetoothSignals() {
  Serial.println("\nScanning for nearby Bluetooth devices (AirPods, Phones, Beacons)...");
  
  // Initialize BLE Scanner
  BLEDevice::init("");
  BLEScan* pBLEScan = BLEDevice::getScan();
  pBLEScan->setActiveScan(true);
  pBLEScan->setInterval(100);
  pBLEScan->setWindow(99);

  // Fixed: pBLEScan->start() returns a pointer (*), so use BLEScanResults*
  BLEScanResults* foundDevices = pBLEScan->start(5, false);
  int count = foundDevices->getCount();

  if (count == 0) {
    Serial.println("No Bluetooth devices found nearby.");
  } else {
    Serial.print("Found ");
    Serial.print(count);
    Serial.println(" Bluetooth signal(s):");
    Serial.println("----------------------------------------------------------------------");

    for (int i = 0; i < count; i++) {
      BLEAdvertisedDevice device = foundDevices->getDevice(i);
      
      String name = device.haveName() ? device.getName().c_str() : "Unknown / Hidden Device";
      String mac = device.getAddress().toString().c_str();
      int rssi = device.getRSSI(); // Signal strength (-40 is close, -90 is far)

      Serial.print("[");
      Serial.print(i + 1);
      Serial.print("] Name: ");
      Serial.print(name);
      Serial.print(" | MAC/ID: ");
      Serial.print(mac);
      Serial.print(" | Signal Strength: ");
      Serial.print(rssi);
      Serial.println(" dBm");
    }
    Serial.println("----------------------------------------------------------------------");
  }
  
  // Clean up memory after scan
  pBLEScan->clearResults();
  Serial.println("Scan complete.\n");
}

void stopAll() {
  Serial.println("\nStopping all wireless broadcasts...");
  
  // Turn off Wi-Fi AP completely
  WiFi.softAPdisconnect(true);
  WiFi.mode(WIFI_OFF);
  Serial.println("Wi-Fi turned OFF.");

  // Turn off Classic Bluetooth if active
  if (btActive) {
    SerialBT.end();
    btActive = false;
    Serial.println("Bluetooth turned OFF.");
  } else {
    Serial.println("Bluetooth was already inactive.");
  }

  Serial.println("All broadcasts stopped successfully.\n");
}

void printHelp() {
  Serial.println("\n--- Available Commands ---");
  Serial.println("/wifi <name>  -> Broadcasts an open Wi-Fi network (Max Power)");
  Serial.println("/bt <name>    -> Broadcasts a Bluetooth device name");
  Serial.println("/signal       -> Scans nearby Bluetooth signals (AirPods, MAC IDs, Signal level)");
  Serial.println("/stop         -> Turns off all active Wi-Fi and Bluetooth broadcasts");
  Serial.println("/help         -> Displays this list");
  Serial.println("--------------------------\n");
}
